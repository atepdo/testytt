local function playLoading(holder, duration)
	local STAGES = {
		{ 0,   "Connecting to server" },
		{ 30,  "Loaded module" },
		{ 65,  "Enable bypass" },
		{ 100, "Ready" },
	}

	local status = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, -46, 0, 18),
		Text = STAGES[1][2],
		TextColor3 = THEME.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		Parent = holder,
	})

	local percent = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(44, 18),
		Text = "0%",
		TextColor3 = THEME.accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		Parent = holder,
	})

	local bar = create("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = THEME.item,
		Parent = holder,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = THEME.accent,
		Parent = bar,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

	tween(fill, duration, { Size = UDim2.new(1, 0, 1, 0) }, Enum.EasingStyle.Linear)

	task.spawn(function()
		local start = os.clock()
		while holder.Parent and not closing do
			local a = math.clamp((os.clock() - start) / duration, 0, 1)
			local pct = math.floor(a * 100)
			percent.Text = pct .. "%"

			local label = STAGES[1][2]
			for _, s in ipairs(STAGES) do
				if pct >= s[1] then label = s[2] end
			end

			if pct < 100 then
				label = label .. string.rep(".", math.floor(os.clock() * 3) % 4)
			end
			status.Text = label

			if a >= 1 then break end
			task.wait()
		end
	end)
end

