local function buildTab(tabName)
	local p = pages[tabName]
	local list = FEATURES[tabName] or {}
	local cards = {}

	addLabel(p, tabName)

	if #list == 0 then
		addParagraph(p, "Belum ada fitur di tab ini.")
		return
	end

	if #list > 5 then
		addTextbox(p, "Cari fitur...", function(txt)
			txt = txt:lower()
			for _, e in ipairs(cards) do
				e.frame.Visible = (txt == "") or (e.name:lower():find(txt, 1, true) ~= nil)
			end
		end)
	end

	for _, f in ipairs(list) do
		local name = f.name or "Tanpa Nama"
		local cb = f.callback
		local frame

		if f.slider then
			frame = addSlider(p, name, f.slider[1], f.slider[2], f.slider[3] or f.slider[1], function(v)
				if cb then cb(v) end
			end).Frame
		elseif f.toggle ~= nil then
			frame = addToggle(p, name, f.toggle, function(on)
				if cb then cb(on) end
			end).Frame
		else
			local c = card(p, 46)
			cardText(c, name, UDim2.new(0, 12, 0, 6), UDim2.new(1, -84, 0, 18), "text", Enum.Font.GothamBold, 13)
			cardText(c, f.desc or "", UDim2.new(0, 12, 0, 24), UDim2.new(1, -84, 0, 16), "subtext", Enum.Font.Gotham, 11)
			local run = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(54, 26),
				AutoButtonColor = false,
				Text = "Run",
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				Parent = c,
			})
			reg(run, "BackgroundColor3", "accent")
			reg(run, "TextColor3", "onAccent")
			create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = run })
			local s = create("UIScale", { Parent = run })
			hoverColor(run, function() return THEME.accent end, function() return THEME.accent:Lerp(WHITE, 0.2) end)
			pressEffect(run, s)
			run.Activated:Connect(function()
				notify("Menjalankan " .. name)
				if not cb then return end
				task.spawn(function()
					local ok, err = pcall(cb)
					if not ok then notify("Error: " .. tostring(err), true) end
				end)
			end)
			frame = c
		end

		table.insert(cards, { name = name, frame = frame })
	end
end

